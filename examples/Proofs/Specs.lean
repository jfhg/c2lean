import Proofs.Calls

/-!
  Hand-written proofs about the generated spec skeletons.
  `C2Lean/Specs_gen.lean` is regenerated by `ll2lean.py`; proofs of the
  skeletons (and concrete instances) live here so regeneration is safe.
-/

namespace C2Lean
open Ll Spec

/-- The generated spec instantiated at `x = 21`, base memory `Mem.empty`:
    the machine returns `42`.  Kernel-checked, no `native_decide`. -/
theorem twice_cspec_21 :
    ∃ (fuel result : Nat) (m : Mem),
      runModule twiceM "twice" [21] fuel Mem.empty = Res.val result m
      ∧ ((result == 2 * 21 : Bool) : Prop) :=
  ⟨7, 42, _, rfl, by decide⟩

/-- Cross-file call: `fact2` (factdriver.c) calls `fact` (fact.c);
    resolved through the linked `projectM`. -/
theorem fact2_5 : (runModule projectM "fact2" [5] 500 Mem.empty).val? = some 120 := by
  native_decide

/-! ## Globals (c/globals.c): `counter` and `table` live at linker-assigned
    addresses; `projectG` is the initial memory seeded from the IR. -/

theorem get_2 : (runModule projectM "get" [2] 100 projectG).val? = some 30 := by
  native_decide

/-- `bump()` then `read_counter()`: the write to the global is visible
    to the next call (state threads through the returned memory). -/
theorem bump_then_read :
    (runModule projectM "read_counter" [] 100
      (cfinMem (runModule projectM "bump" [] 100 projectG))).val? = some 1 := by
  native_decide

end C2Lean
