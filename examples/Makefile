# c2lean examples — the acceptance gate.
#
#   make       translate every .c to Lean, build everything with lake
#              (the kernel checks every proof), print the axiom audit:
#              `AUDIT <name>` = proved spec + its axioms,
#              `AUDIT-MISSING <name>` = spec without a proof.
#   make gen   only write the generated Lean (into build/)
#   make clean remove everything generated (stays inside examples/)
#
# Everything generated lives under build/ (gitignored); the source tree
# is purely handwritten Lean.  `lake` must run from the repo root.

PY ?= python
SRC := $(wildcard *.c)
.DEFAULT_GOAL := all   # (explicit: `gen` must not become the default)

.PHONY: all gen clean

gen:
	@mkdir -p build/C2Lean
	@$(PY) ../c2lean.py $(SRC) -o build/C2Lean/Programs.lean
	@{ echo "-- GENERATED by the Makefile (from Proofs/*.lean) -- do not edit"; \
	   for f in Proofs/*.lean; do echo "import Proofs.$$(basename $$f .lean)"; done; } > Proofs.lean

all: gen
	@cd .. && lake build
	@cd .. && lake env lean examples/build/C2Lean/Audit.lean

clean:
	rm -rf build Proofs.lean
