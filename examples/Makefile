# c2lean examples — this is where the action is.
#
# The tools at the repo root are interpreted (Python + a Lean library);
# nothing to build there.  This Makefile *uses* the tool and demonstrates
# its capabilities:
#
#   make                 convert ALL .c files to Lean and check everything
#   make gen             only write per-example Lean files into build/
#   make check PROG=fact generate + elaborate one example standalone
#   make lint            frontend input validation only (no writes)
#   make calibrate       MCJIT ground-truth cross-check against real machine code
#   make clean           remove build/ (stays inside examples/)
#
# Plain `make` is the full acceptance gate:
#   1. regenerate the linked Lean project  → build/C2Lean/{Programs,Audit}.lean
#   2. regenerate per-example files in build/ and elaborate each standalone
#      (the "handoff kit" property: every example's statements compile on
#       their own, against just the semantics + SpecLib)
#   3. lake build        — the kernel checks every committed proof
#   4. axiom audit       — sorryAx fails the build; STRICT=1 also demands
#                          that every spec has a proof
#
# Generated artifacts — including the linked Lean modules (Programs, Audit)
# — all live under build/ (gitignored); the source tree is purely handwritten
# Lean.  `lake` must run from the repo root, hence the `cd ..` invocations.

.DEFAULT_GOAL := all   # (targets above `all` must not become the default)

PY ?= python
SRC  := $(wildcard *.c)
LEAN := $(patsubst %.c,build/%.lean,$(SRC))

.PHONY: all gen check lint calibrate clean

# The aggregator module is generated, never committed: every file that
# appears in Proofs/ is picked up automatically.
Proofs.lean: $(wildcard Proofs/*.lean)
	@{ echo "-- GENERATED by the Makefile (from Proofs/*.lean) -- do not edit"; \
	   for f in $^; do echo "import Proofs.$$(basename $$f .lean)"; done; } > $@

all: gen Proofs.lean
	@mkdir -p build/C2Lean
	@$(PY) ../c2lean.py $(SRC) -o build/C2Lean/Programs.lean
	@cd .. && lake build
	@for f in $(LEAN); do \
	  l=$$(basename $$f); \
	  ( cd .. && lake env lean "examples/$$f" > "examples/build/$$l.log" 2>&1 ) \
	    || { echo "FAILED: $$f"; cat "build/$$l.log"; exit 1; }; done
	@cd .. && lake env lean examples/build/C2Lean/Audit.lean > examples/build/audit.log 2>&1 \
	  || { cat build/audit.log; exit 1; }
	@if grep -q sorryAx build/audit.log; then \
	  echo "AUDIT FAILED — sorryAx in spec proofs:"; grep sorryAx build/audit.log; exit 1; \
	fi
	@grep -h "AUDIT " build/audit.log || true
	@grep -h AUDIT-MISSING build/audit.log | sed "s/^/  note: /" || true
ifdef STRICT
	@if grep -q AUDIT-MISSING build/audit.log; then \
	  echo "STRICT FAIL — specs without proofs:"; grep AUDIT-MISSING build/audit.log; exit 1; \
	fi
	@echo "make STRICT=1: OK — every spec has a kernel-checked, sorry-free proof"
else
	@echo "OK — inputs valid, proofs kernel-checked, audit clean (STRICT=1 demands full coverage)"
endif

build:
	@mkdir -p build

build/%.lean: %.c ../c2lean.py | build
	@$(PY) ../c2lean.py $< -o $@

gen: $(LEAN)
	@echo "generated: $(LEAN)"

check:
	@$(PY) ../c2lean.py $(PROG).c -o build/$(PROG).lean
	@cd .. && lake env lean examples/build/$(PROG).lean

lint:
	@mkdir -p build/C2Lean
	@$(PY) ../c2lean.py --check $(SRC) -o build/C2Lean/Programs.lean

calibrate:
	@mkdir -p build/C2Lean
	@$(PY) ../c2lean.py $(SRC) -o build/C2Lean/Programs.lean
	@cd .. && $(PY) tools/jit_gen.py && lake build C2Lean.McjitCheck

# clean stays INSIDE examples/ and now removes EVERYTHING generated:
# build/ holds the per-example files, the linked Programs/Audit modules,
# and the calibration module.
clean:
	rm -rf build Proofs.lean
