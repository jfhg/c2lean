# c2lean examples — this is where the action is.
#
# The tools at the repo root are interpreted (Python + a Lean library);
# nothing to build there.  This Makefile *uses* the tool and demonstrates
# its capabilities:
#
#   make                 the full acceptance gate (everything below)
#   make gen             per-example Lean files only (into build/)
#   make check PROG=fact regenerate + elaborate one example standalone
#   make lint            frontend input validation only (no writes)
#   make calibrate       MCJIT ground-truth cross-check against real machine code
#   make clean           remove build/ + generated Proofs.lean (stays inside examples/)
#
# Structure: every generated artifact is a file rule declaring its real
# prerequisites, so everything is incremental and safe to run piecewise:
#
#   build/C2Lean/Programs.lean   linked project (+ Audit.lean) ← sources, c2lean.py
#   build/<stem>.lean            per-example standalone file   ← its one .c, c2lean.py
#   Proofs.lean                  proof aggregator              ← Proofs/*.lean
#   build/generated.stamp        lake build of the GENERATED half (fast)
#   build/examples.stamp         lake build of everything incl. proofs (heavy)
#   build/audit.log              axiom audit of the spec proofs
#
# The acceptance gate is then just `all: standalone audit`:
#   - `standalone`: each example's statements elaborate on their own,
#     against just the semantics + SpecLib (the handoff-kit property);
#   - `audit`: lake build (kernel checks every proof), then collectAxioms;
#     sorryAx fails the build; a nonempty STRICT also demands that every
#     spec has a proof.
#
# Generated artifacts all live under build/ (gitignored); the source tree
# is purely handwritten Lean.  `lake` must run from the repo root, hence
# the `cd ..` invocations.

.DEFAULT_GOAL := all

PY ?= python
SRC      := $(wildcard *.c)
LEAN     := $(patsubst %.c,build/%.lean,$(SRC))
PROGRAMS := build/C2Lean/Programs.lean
AUDIT    := build/C2Lean/Audit.lean

# handwritten Lean that the generated/proof code depends on
LIBLEAN    := ../C2Lean.lean ../C2Lean/SpecLib.lean $(wildcard ../C2Lean/Semantics/*.lean)
PROOFLEAN  := $(wildcard Proofs/*.lean)

.PHONY: all gen check lint calibrate clean standalone audit

# ────────────────────────────── generation ──────────────────────────────

build build/C2Lean:
	@mkdir -p $@

# The linked project: one invocation translates the WHOLE project and
# writes Programs.lean plus Audit.lean next to it.
$(PROGRAMS): $(SRC) ../c2lean.py | build/C2Lean
	@$(PY) ../c2lean.py $(SRC) -o $(PROGRAMS)

$(AUDIT): $(PROGRAMS)
	@test -f $@

build/%.lean: %.c ../c2lean.py | build
	@$(PY) ../c2lean.py $< -o $@

gen: $(LEAN)
	@echo "generated: $(LEAN)"

# The aggregator module is generated, never committed: every file that
# appears in Proofs/ is picked up automatically.
Proofs.lean: $(PROOFLEAN)
	@{ echo "-- GENERATED by the Makefile (from Proofs/*.lean) -- do not edit"; \
	   for f in $^; do echo "import Proofs.$$(basename $$f .lean)"; done; } > $@

# ─────────────────────────────── builds ─────────────────────────────────

# Generated half only (semantics + Programs): enough for standalone
# elaboration of example statements; skips the (heavy) proof library.
build/generated.stamp: $(PROGRAMS) $(LIBLEAN) | build
	@cd .. && lake build Generated
	@touch $@

# Everything, including every committed proof (the kernel check).
build/examples.stamp: build/generated.stamp Proofs.lean $(PROOFLEAN)
	@cd .. && lake build
	@touch $@

# ─────────────────────────────── checks ─────────────────────────────────

# Handoff-kit property: every example's statements elaborate standalone,
# against only the semantics + SpecLib.
standalone: build/generated.stamp $(LEAN)
	@for f in $(LEAN); do \
	  l=$$(basename $$f); \
	  ( cd .. && lake env lean "examples/$$f" > "examples/build/$$l.log" 2>&1 ) \
	    || { echo "FAILED: $$f"; cat "build/$$l.log"; exit 1; }; done
	@echo "standalone: OK ($(words $(LEAN)) examples elaborate on their own)"

build/audit.log: build/examples.stamp
	@cd .. && lake env lean examples/build/C2Lean/Audit.lean > examples/build/audit.log 2>&1 \
	  || { cat build/audit.log; exit 1; }
	@if grep -q sorryAx build/audit.log; then \
	  echo "AUDIT FAILED — sorryAx in spec proofs:"; grep sorryAx build/audit.log; exit 1; \
	fi

audit: build/audit.log
	@grep -h "AUDIT " build/audit.log || true
	@grep -h AUDIT-MISSING build/audit.log | sed "s/^/  note: /" || true
# STRICT semantics: any truthy value enables (STRICT=0/false/no/off does not).
ifneq ($(filter-out 0 false no off,$(strip $(STRICT))),)
	@if grep -q AUDIT-MISSING build/audit.log; then \
	  echo "STRICT FAIL — specs without proofs:"; grep AUDIT-MISSING build/audit.log; exit 1; \
	fi
	@echo "STRICT: OK — every spec has a kernel-checked, sorry-free proof"
else
	@echo "OK — inputs valid, proofs kernel-checked, audit clean (STRICT=1 demands full coverage)"
endif

all: standalone audit

# One example, end to end, without touching the rest.
check:
ifeq ($(strip $(PROG)),)
	$(error usage: make check PROG=<name>, e.g. make check PROG=fact)
endif
ifeq ($(filter $(PROG).c,$(SRC)),)
	$(error no such example: $(PROG).c (found: $(SRC)))
endif
	@$(MAKE) --no-print-directory build/generated.stamp
	@$(PY) ../c2lean.py $(PROG).c -o build/$(PROG).lean
	@cd .. && lake env lean examples/build/$(PROG).lean
	@echo "check $(PROG): OK"

# ────────────────────────────── front door ──────────────────────────────

lint:
	@mkdir -p build/C2Lean
	@$(PY) ../c2lean.py --check $(SRC) -o $(PROGRAMS)

calibrate: build/generated.stamp
	@$(PY) ../tools/jit_gen.py
	@cd .. && lake build C2Lean.McjitCheck

# clean stays INSIDE examples/ and removes EVERYTHING generated:
# build/ holds the per-example files, the linked Programs/Audit modules,
# the calibration module, and the build stamps.  The lake cache (.lake/)
# is deliberately untouched: lake keys on content hashes, so a regenerated
# byte-identical project replays cached elaboration.
clean:
	rm -rf build Proofs.lean
